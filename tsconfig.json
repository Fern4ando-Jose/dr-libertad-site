{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `Arquivo-Midia/` é o DEPÓSITO de mídia/resgate da casa (regra de higiene do
  // workspace), não código do site: não é rastreado no git e o CI nunca o vê.
  // Sem esta linha, um resgate antigo lá dentro reprovava a conferência LOCAL de
  // todo mundo — e a trava de commit é fail-closed, então ninguém publicava.
  "exclude": ["node_modules", "Arquivo-Midia"]
}
